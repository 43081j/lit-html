{
  "name": "eslint-plugin-lit",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "description": "Lit support for ESLint",
  "license": "BSD-3-Clause",
  "author": "Google LLC",
  "homepage": "https://github.com/lit/lit/tree/main/packages/labs/esling-plugin-lit",
  "repository": {
    "type": "git",
    "url": "https://github.com/lit/lit.git",
    "directory": "packages/labs/esling-plugin-lit"
  },
  "main": "index.js",
  "scripts": {
    "build": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:types"
      ],
      "command": "esbuild --platform=node --bundle --outfile=index.js --format=cjs --external:typescript --external:tslib --external:espree --external:@typescript-eslint src/index.ts",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "index.{js,js.map,d.ts,d.ts.map}"
      ],
      "clean": "if-file-deleted"
    },
    "build:types": {
      "dependencies": [
        "../analyzer:build"
      ],
      "command": "tsc --build --pretty",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "lib",
        "test",
        "tsconfig.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "#comment": "The quotes around the file regex must be double quotes on windows!",
      "command": "c8 --reporter=lcov mocha \"lib/test/**/*_test.js\"",
      "dependencies": [
        "build"
      ],
      "files": [],
      "output": []
    }
  },
  "files": [
    "index.*",
    "/lib/",
    "!/lib/.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "require": "./index.js"
    }
  },
  "peerDependencies": {
    "eslint": ">= 8"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@lit-labs/analyzer": "^0.11.0",
    "@typescript-eslint/utils": "^6.7.5"
  },
  "devDependencies": {
    "@types/eslint": "^8.44.3",
    "@types/node": "^20.8.0",
    "@typescript-eslint/rule-tester": "^6.7.5",
    "c8": "^8.0.1",
    "chai": "^5.0.0-alpha.1",
    "esbuild": "^0.19.4",
    "eslint": "^8.50.0",
    "mocha": "^10.2.0",
    "typescript": "~5.2.0"
  }
}
